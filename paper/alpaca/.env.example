APCA_API_KEY_ID=your_paper_key
APCA_API_SECRET_KEY=your_paper_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_FEED=sip
FMP_API_KEY=your_fmp_key
ALPACA_CLASSIFICATION_SOURCE=fmp

# Optional runtime knobs
# Keep this on the baseline model until research_runner promotes an approved
# paper/alpaca/private/selected_strategy.json, which daily_pipeline will pick up automatically.
ALPACA_SIGNAL_MODEL=profit_asset_gate_proxy
ALPACA_TOP_N=30
ALPACA_GROSS_EXPOSURE=4.0
ALPACA_BOOK_MODE=sector
ALPACA_KILL_SWITCH_DAILY_RETURN=-0.02
ALPACA_ROUND_TRIP_COST_BPS=5
ALPACA_MIN_ORDER_NOTIONAL=50
ALPACA_BP_UTILIZATION=0.90
ALPACA_MARGIN_BUFFER_NOTIONAL=0
ALPACA_MAX_RETRY_PASSES=3
ALPACA_SCHEDULER_TASK_NAME=WQA_Alpaca_Rebalance_0935ET
ALPACA_SCHEDULER_TIME_ET=09:35

# Nightly search pipeline
ALPHA_SEARCH_BATCH_SIZE=10
ALPHA_SEARCH_MAX_RUNTIME_MIN=480
ALPHA_SEARCH_TASK_NAME=WQA_Alpaca_Research_2300

# Optional free-model mutation provider (OpenAI-compatible)
# ALPHA_GEN_API_BASE=https://your-provider.example/v1
# ALPHA_GEN_API_KEY=your_key
# ALPHA_GEN_MODEL=your_model
